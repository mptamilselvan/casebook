# Copy these keys into mobile/assets/env. That is the only file the app reads.
#
# Android emulator: http://10.0.2.2:8000/api
# Physical phone on same Wi-Fi: http://YOUR_MAC_IP:8000/api
API_BASE_URL=http://127.0.0.1:8000/api

# Public OneSignal app id. Do not put ONESIGNAL_REST_API_KEY in the app.
ONESIGNAL_APP_ID=
