# Flutter cannot package a file named ".env".
# Put API_BASE_URL in assets/env (that is what the app loads).
#
# Android emulator: http://10.0.2.2:8000/api
# Physical phone on same Wi-Fi: http://YOUR_MAC_IP:8000/api
API_BASE_URL=http://127.0.0.1:8000/api

# Document and image uploads are sent to the Laravel API. The API saves them
# in the Hugging Face bucket configured in laravel-web/.env. Do not put
# HF_S3 credentials in the app; they would ship inside the install.
