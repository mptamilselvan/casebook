APP_NAME="Case Book"
APP_TIMEZONE=Asia/Kolkata
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=casebook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=localhost

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Hugging Face Storage Bucket. Use "namespace/bucket" or the bare bucket name.
# Endpoint is https://<namespace>.s3.hf.co. The web and mobile apps upload
# through Laravel, which writes case files to this bucket.
HF_S3_ACCESS_KEY=
HF_S3_SECRET_KEY=
HF_S3_BUCKET=
HF_S3_REGION=us-east-1
HF_S3_ENDPOINT=

# OneSignal. The app id is public and is also used by the website and mobile app.
# The REST API key stays on the server and sends the hearing reminders.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Razorpay. The key id is sent to the checkout. The secret stays on the server.
# Webhook URL: POST /webhooks/razorpay
# If the dashboard webhook secret differs from the key secret, set it here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
